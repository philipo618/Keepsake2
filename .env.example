# VITE_BASE_PATH:
# - Defaults to "/Keepsake2/" during production builds (`npm run build`) and "/" in local dev (`npm run dev`).
# - Override to "/" if deploying to a custom domain or <username>.github.io root site.
VITE_BASE_PATH="/Keepsake2/"

# Cloudinary Direct Browser Unsigned Upload Configuration
# Verified public unsigned identifiers for Keepsake2:
# SECURITY WARNING: NEVER set or expose Cloudinary API_SECRET in client-side .env variables or source code.
VITE_CLOUDINARY_CLOUD_NAME="jbo6hxur"
VITE_CLOUDINARY_UPLOAD_PRESET="Keepsake2"
